# Raw gaussian-splat training artifacts — never commit (huge, redundant with .sog)
raw/
*.ply

# OS noise
.DS_Store

# Node
node_modules/

# Python bytecode and the pose cache tools/sfm_vis.py writes
__pycache__/
*.pyc
*.npz

# Local articulated mannequin editing copy (regenerate with prepare_mannequin.py)
/viewers/mannequin-rig/scan.bin

# Local fusion environment and intermediate review data
.venv-fusion/
.venv-mannequin/
/viewers/mannequin-fusion/*.bin
# The published interactive viewers need these four prepared scan exports.
!/viewers/mannequin-fusion/front.bin
!/viewers/mannequin-fusion/back.bin
!/viewers/mannequin-fusion/front-labels.bin
!/viewers/mannequin-fusion/back-labels.bin
